defs:
  SRC := realpath(${HERMES_CONTEXT_SRC:-/opt/data/workspace/hermes-context/})
  DST := realpath(${HERMES_CONTEXT_DST:-/workspace/hermes-context/})
  sync_ps := [rsync --delete path, cp-fallback/tar-pipe path with recursive reconcile]
  mirror := exact content+structure+symlink equivalence, recursive, per A9 class (¬metadata, ¬timestamps, ¬hardlink topology)
invariants:
  A1: SRC := /opt/data/workspace/hermes-context/, DST := /workspace/hermes-context/ (exists, holds INDEX.md, agents/, config/)
  A2: sync direction host -> workspace, one-way; ¬∃ writeback to SRC
  A3: units := systemctl --user; script standalone-runnable (cron/ installer callable) when ¬systemd
  A4: rsync-missing -> cp -a / tar-pipe fallback; sync CONTENTS src/ -> dst, ¬nest src inside dst
  A5_mirror: ∀ sync_path -> DST end state == exact mirror of SRC, recursive; stale DELETED, ¬accumulate-only
  A6_purity: ∀ run with --dry-run -> zero writes ∀ kind incl. log files; DST byte-identical pre/post dry-run
  A7: A5 recursive — cp-fallback deletes stale subtrees ∀ depth (≡ rsync --delete); README sync-strategy states this
  A8_placement: log := outside DST ∀ (default ~/.cache/hermes-context/log); install paths := ~/.local/bin or /workspace/hdcs/bin, ¬artifact/ inside DST; sync ¬deletes/moves own entrypoints
  A9_class: verify(contents ∧ structure ∧ symlinks, recursive); mismatch -> exit ¬0, ¬warn-exit-0; metadata complaints out-of-scope
  A10_bar: FAIL iff defect reachable in normal operation (default config, documented usage, plausible data-losing misconfig); exotic triggers -> KNOWN_LIMITATIONS in +open with repro notes; judge cites ∀ findings, bar classifies ¬suppresses
  A11_destructive: guard SRC==DST (reject/clean no-op); ¬rm -rf DST before verified copy of SRC exists elsewhere; source survival > mirror freshness
  A12_identity: compare realpath identity ¬string equality; refuse (clean ¬0, ¬writes) iff realpath(SRC)==realpath(DST) ∨ ancestor/descendant relation ∨ DST resolves through symlink into SRC; applies ∀ sync paths before ∀ destructive op
  A13_order: stage -> verify (content-compare vs SRC, A9 class; ¬non-emptiness) -> only then touch DST; staging-verify fail -> exit ¬0; README ¬calls unverified copy "verified"
open:
  KNOWN_LIMIT: newline-in-filename corpora
  KNOWN_LIMIT: hostile env combos (e.g. DST -> log dir) per A10 classification
validation:
  V1: dry-run byte-identity gate on DST (A6)
  V2: mirror equality check contents+structure+symlinks recursive, nonzero exit on mismatch (A5/A7/A9)
  V3: path-identity guard unit-test: same realpath, ancestor, symlinked-into cases (A12)
  V4: destructive-op sequencing audit: ¬touch DST pre staging-verify (A11/A13)
