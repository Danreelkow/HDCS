defs:
  SRC := /opt/data/workspace/hermes-context/ (host-mount, read-only w.r.t. sync)
  DST := /workspace/hermes-context/ (artifact deliverable)
  sync := one-way host -> workspace; nothing writes back to host mount
invariants:
  A1_paths: SRC/DST as operator-answered; DST exists w/ INDEX.md, agents/, config/
  A3_standalone: script runs w/o systemd; user units are preferred scheduler
  A4_fallback: ¬∃rsync -> cp -a-semantics/tar-pipe fallback; sync CONTENTS src/ -> dst, never nesting
  A5_mirror: ∀ path -> DST end state == SRC end state, stale deleted, recursive
  A6_dryrun: --dry-run -> zero writes ∀ targets incl. logs; DST byte-identical post-run
  A7_recursive: reconciliation deletes stale subtrees ∀ depth; README states this correctly
  A8_placement: log outside DST always (~/.cache default); entrypoints outside mirrored tree (~/.local/bin)
  A9_mirrorclass: mirror = {contents, dir structure recursive, symlinks} only; metadata/timestamps/hardlinks excluded; self-verify FAILs nonzero on mismatch, never warn-and-0
  A10_bar: FAIL only on normal-operation defects; exotic env corpora -> +open KNOWN_LIMITATIONS
  A11_destructive: guard SRC==DST; never rm -rf DST before verified copy of SRC exists
  A12_pathid: realpath-identity guard (ancestor/descendant/symlink-into-SRC), both paths, pre-destruction
  A13_verified: stage -> content-compare (A9 class) -> only then touch DST; README wording compliant
  A14_guard: refuse (clean nonzero, no writes) if DST realpath ∈/⊃ script-owned paths (log, stage, entrypoints, TMPDIR-resolved stage); env-interaction theme CLOSED
open: [] (no +open items; A10-class exotics covered by A14 closure)
