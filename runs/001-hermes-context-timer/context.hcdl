defs:
  SRC := $HERMES_CONTEXT_SRC, default /opt/data/workspace/hermes-context/
  DST := $HERMES_CONTEXT_DST, default /workspace/hermes-context/
  ART := artifact dir containing sync-hermes-context.sh, hermes-context.service, hermes-context.timer, README.md
  LOG := one-line run summary, path via HERMES_CONTEXT_LOG, default ~/.cache/, NEVER ∈ DST
  rsync_path := rsync -a --delete (contents of SRC -> DST, trailing-slash src/)
  cp_path := fallback when rsync absent; tar-pipe or cp -a + recursive reconcile
invariants:
  A1: SRC=/opt/data/workspace/hermes-context/, DST=/workspace/hermes-context/ (exists, holds INDEX.md, agents/, config/)
  A2: ∀ sync -> direction host->workspace one-way; ¬∃ writeback to SRC
  A3: units are systemctl --user; ¬root; script standalone-capable (cron/caller invokes directly)
  A4: script detects rsync absence -> cp_path fallback; sync CONTENTS (src/ -> dst), ¬nest SRC inside DST
  A5_mirror: ∀ path ∈ {rsync_path, cp_path} -> DST end state == SRC end state exactly; stale files DELETED, ¬accumulate-only
  A6_purity: --dry-run -> ZERO writes ∀ kind incl. logs; DST byte-identical post-dry-run
  A7_recursive: reconcile deletes stale subtrees ∀ depth; recursive convergence both paths
  A8_placement: LOG ∉ DST ∀ mode; install paths ∉ mirrored tree (~/.local/bin or /workspace/hdcs/bin); sync never deletes/moves own entrypoints
  A9_class: mirror ≡ {file contents, dir structure (recursive), symlinks}; ∉ class: metadata, timestamps, hardlink topology; self-verify FAIL(nonzero) on mismatch, ¬warn-exit-0
  A10_bar: FAIL only on defects reachable in normal operation; exotic triggers -> KNOWN_LIMITATIONS (+open), classify ¬suppress
  A11_guard: guard SRC==DST; ∀ rm -rf DST -> precondition ∃ verified copy of SRC elsewhere; SRC survival > freshness
  A12_identity: compare realpath(SRC) vs realpath(DST); refuse(clean nonzero, no writes) if equal ∨ ancestor/descendant ∨ DST resolves through symlink into SRC; enforced ∀ path pre-destructive
  A13_verified: verified := contents+structure+symlinks (A9 class) compared vs SRC ∧ match; ¬non-emptiness; order: stage -> verify -> touch DST; README ¬call unverified copy "verified"
open:
  KNOWN_LIMITATIONS: newline-in-filename corpora; hostile env (DST := log dir); per A10 non-blocking
validation:
  dry-run byte-identity gate; recursive mirror equality both paths; realpath guards; staging verify gate
