defs:
  SRC := $HERMES_CONTEXT_SRC default /opt/data/workspace/hermes-context/
  DST := $HERMES_CONTEXT_DST default /workspace/hermes-context/
  rsync_path := rsync -a --delete src/ -> dst/ (contents, no nesting)
  fallback_path := cp -a + recursive reconciliation (delete stale subtrees ∀ depth)
  mirror_class := {file contents, dir structure recursive, symlinks}; ¬{timestamps, metadata, hardlink topology} per A9
invariants:
  A2_oneway: ∀ run -> writes only to DST; SRC read-only
  A5_mirror: ∀ path ∈ {rsync_path, fallback_path} -> DST end state == SRC end state, recursive (A7)
  A6_purity: --dry-run -> ∀ write == 0, incl. logs; DST byte-identical post-run
  A8_placement: log ∈ ~/.cache (outside DST always); entrypoints ∈ ~/.local/bin | /workspace/hdcs/bin, never inside DST; sync never deletes own entrypoints
  A3_standalone: script executable w/o systemd; units user-level (systemctl --user), no root
  A4_detect: rsync absent -> fallback_path engaged
  self_verify: verify mirror_class recursively; mismatch -> exit != 0 (never warn+0)
open: none — all ambiguities resolved by A1-A9
