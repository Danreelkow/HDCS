A1_dry: DRY -> zero writes ∀ path (no ARCHIVE_DIR/state creation); --apply sole writer
A2_toolchain: pure bash + coreutils (find, cmp, realpath, cksum); logrotate ∉ deps
A4_path_law: ∀ conf/env resolution -> refuse RUNS_DIR==ARCHIVE_DIR ∨ containment ∨ degenerate ('', '.', '/'); refusal cites A-numbers ∧ precedes ∀ write; env HDCS_RUNS_DIR/HDCS_ARCHIVE_DIR > conf; set-but-empty -> refuse
A5_move_once: ∀ file age ≥ AGE_DAYS -> moved exactly once; 2nd --apply -> zero-action
A5_bytes: ∀ path -> DST end state == SRC end state, recursive; verified via cmp; archived name := <name> + rotation suffix
A6_verify: exit 0 iff conf parses ∧ ¬∃ stale-matching file under RUNS_DIR ∧ archived listing consistent; else exit ≥ 1
A7_race: exotic names/races -> KNOWN_LIMITATIONS section, ¬ FAIL verdict
conf_schema: exactly {RUNS_DIR, ARCHIVE_DIR, AGE_DAYS, PATTERN, KEEP}
open: ∅
